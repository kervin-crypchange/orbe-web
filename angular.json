{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "orbe-web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "ssr": false,
            "prerender": false,
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/notyf/notyf.min.js",
              "node_modules/dropzone/dist/dropzone-min.js",
              "node_modules/lodash/lodash.js",
              "node_modules/flyonui/flyonui.js"
            ],
            "assets": [
              "src/web.config",
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/tinymce",
                "output": "/tinymce"
              }
            ],
            "styles": [
              "node_modules/ngx-spinner/animations/ball-scale-multiple.css",
              "node_modules/notyf/notyf.min.css",
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "define": {
                "API_URL": "'https://api.orbeapp.net'",
                "API_SOCKET": "'https://wss.orbeapp.net'",
                "APP_VERSION": "'1.0.0'",
                "ENV": "'production'",
                "WOMPI_PUBLIC_KEY": "'pub_prod_8EOPXgPdw9nsfSGBjnGS3n6rnwWey5y1'",
                "WOMPI_PRIVATE_KEY": "'prv_prod_OiJZKdDjD2sBhJfSXLpm3nxDqeez5VNI'",
                "WOMPI_EVENT": "'prod_events_6LQ7mnzPgHbU3lvD3opdNE1rSuLmiFjk'",
                "WOMPI_INTEGRITY": "'prod_integrity_0Jilhxdrf1T1sJffFBDvY9g7DJKCO04w'"

               
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ],
              "define": {
                "API_URL": "'http://localhost:3000'",
                "API_SOCKET": "'https://wss.orbeapp.net'",
                "APP_VERSION": "'1.0.0'",
                "ENV": "'development'",
                "WOMPI_PUBLIC_KEY": "'pub_test_W2AG0iuu4cMtL2w64njejkl5lLj4aVxL'",
                "WOMPI_PRIVATE_KEY": "'prv_test_p1UCIxTuABmDFbUtVw2Xvs5i7Ns8PPzc'",
                "WOMPI_EVENT": "'test_events_yPkClYv8sZPiYFrdp43xV2HIUrup2s8F'",
                "WOMPI_INTEGRITY": "'test_integrity_OkY0VOFyFpVtRDCdU617aS8uTlwwqKAK'"                
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "orbe-web:build:production"
            },
            "development": {
              "buildTarget": "orbe-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
